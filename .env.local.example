# Supabase の Project Settings > API で確認できる値
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用（ユーザー登録と、プッシュ通知の購読の保存・送信に使う）。公開しないこと。NEXT_PUBLIC_ は付けない
SUPABASE_SERVICE_ROLE_KEY=

# 登録画面で入力してもらう合言葉（友達に教える言葉）
INVITE_CODE=

# プッシュ通知（任意。3つとも入れたときだけ通知が動く。空のままでもアプリは普通に使える）
# 鍵は `npx web-push generate-vapid-keys` で作る（Public Key と Private Key が出る）
# 公開鍵: ビルド時にブラウザ用のコードへ埋め込まれる。登録・変更したあとは再デプロイが必要
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 秘密鍵: サーバー専用。公開しないこと。NEXT_PUBLIC_ は付けない。作り直すと、今ある購読はすべて無効になる
VAPID_PRIVATE_KEY=
# 連絡先: mailto:あなたのメールアドレス、または https:// で始まるURL
VAPID_SUBJECT=mailto:you@example.com
